DATABASE_URL=postgresql://postgres:postgres@localhost:5433/finance_manager
AUTH_SECRET=your_nextauth_secret_here
CRON_SECRET=your_cron_secret_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (VAPID)
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:test@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:test@example.com

# Provedor de Email (Resend ou SMTP)
# Opção 1: Resend (Recomendado)
RESEND_API_KEY=
EMAIL_FROM=FinanceManager <onboarding@resend.dev>

# Opção 2: SMTP (Gmail, Outlook, Amazon SES, Brevo, Mailtrap, etc.)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=

# Open Finance + IA (plano_migracao.xml) — projeto Supabase separado do Neon acima
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=

# Definidos pela própria aplicação (não vêm de nenhum provedor externo):
# FINANCE_OWNER_USER_ID = id (tabela users) do usuário dono da conexão Open Finance
# PLUGGY_WEBHOOK_SECRET = string aleatória sua, usada como ?token= na URL do webhook
FINANCE_OWNER_USER_ID=
PLUGGY_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_SECRET = string aleatória sua, passada como secret_token no setWebhook
TELEGRAM_WEBHOOK_SECRET=
# ANALYZE_SPENDING_SECRET não é lida por este app Next.js — é um secret da Supabase
# Edge Function supabase/functions/analyze-spending, configurado via
# `supabase secrets set` e no Vault do projeto Supabase (ver 0002_cron_analyze.sql).
# Documentado aqui só para não se perder entre os secrets do projeto.
