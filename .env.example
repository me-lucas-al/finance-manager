# Configurações de Banco de Dados
DATABASE_URL=postgresql://user:password@localhost:5432/finance_manager

# Autenticação
# Gere um valor aleatório forte, ex: openssl rand -base64 32
AUTH_SECRET=

# Protege o endpoint de fechamento automático (/api/cron/closing) contra chamadas externas
CRON_SECRET=

# Web Push Notifications (VAPID) - gere com: npx web-push generate-vapid-keys
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:seu_email@dominio.com
